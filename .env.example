# image-gen-mcp — OpenAI credentials.
# Preferred: set OPENAI_API_KEY in the MCP server's `env` block in Claude Code
# (/mcp). This .env is only a convenience for local dev / running the smoke test.
#
# Copy this file to .env and fill in the value:
#   cp .env.example .env

OPENAI_API_KEY=

# Optional override (defaults shown):
# OPENAI_BASE_URL=https://api.openai.com/v1
